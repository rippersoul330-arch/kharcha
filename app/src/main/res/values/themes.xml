<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme. Compose supplies the real colours; this mainly sets the
         window background and bars for the activity chrome. -->
    <style name="Theme.Kharcha" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Transparent theme for the floating quick-entry activity so the card
         appears over whatever app the user was in, with a dim scrim. -->
    <style name="Theme.Kharcha.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
